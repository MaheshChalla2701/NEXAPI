# Copy to .env (git-ignored) only if you want to change defaults.
# The app needs no key: the AI Analyst runs locally unless external mode is enabled here.

# --- optional external AI (off by default) ---
ANALYST_EXTERNAL_ENABLED=false
ANALYST_PROVIDER=anthropic
# ANTHROPIC_API_KEY=            # never commit a real key
ANALYST_MODEL=claude-opus-5-5
ANALYST_EFFORT=medium
ANALYST_TIMEOUT_S=60

# --- server ---
# APP_HOST=127.0.0.1
# APP_PORT=8000
# APP_DB_PATH=var/app.db
